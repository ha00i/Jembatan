# Token GitHub untuk API/clone/push. UI menggunakan ADMIN_TOKEN bila diisi.
GITHUB_TOKEN=github_pat_isi_di_sini
# Disarankan: token terpisah untuk login web UI. Bila kosong, UI menggunakan GITHUB_TOKEN.
ADMIN_TOKEN=
# QA kini dijalankan manual dari menu Docker & QA memakai profil per aplikasi,
# bukan lewat TEST_CMD yang memiliki akses socket production.
# Opsional. Deploy dari folder yang sudah ada, contoh:
# DEPLOY_MAP={"owner/Vortex-ERP":"/srv/vortex-erp"}
DEPLOY_MAP=
