# Token ini juga dipakai untuk masuk ke web UI.
GITHUB_TOKEN=github_pat_isi_di_sini
# Disarankan: token terpisah untuk login web UI. Bila kosong, UI menggunakan GITHUB_TOKEN.
ADMIN_TOKEN=
# Opsional pada versi sekarang. Wajib sebelum auto-merge diaktifkan.
# Jalankan test lewat Docker milik proyek, contoh:
# TEST_CMD=docker compose run --rm app npm test
TEST_CMD=
# Opsional. Deploy dari folder yang sudah ada, contoh:
# DEPLOY_MAP={"owner/Vortex-ERP":"/srv/vortex-erp"}
DEPLOY_MAP=
